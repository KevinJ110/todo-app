rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserPath(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // TaskFlow data is private and scoped to the authenticated user's UID.
    match /users/{userId}/tasks/{taskId} {
      allow read, write: if ownsUserPath(userId);
    }

    match /users/{userId}/incidents/{incidentId} {
      allow read, write: if ownsUserPath(userId);
    }

    match /users/{userId}/notes/{noteId} {
      allow read, write: if ownsUserPath(userId);
    }

    // Do not expose user documents or any collections not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Firestore rules are intentionally path-scoped. Application validation remains
// responsible for user-facing field requirements and document shape.
